# ==================== 平台配置 ====================

# IM 平台选择（当前支持: feishu）
IM_PLATFORM=feishu

# ==================== 飞书配置 (使用飞书时必填) ====================

# 飞书应用 App ID（必填）
FEISHU_APP_ID=your_app_id
# 飞书应用 App Secret（必填）
FEISHU_APP_SECRET=your_app_secret

# 消息发送配置
# 接收ID类型：open_id, user_id 或 union_id
FEISHU_MESSAGE_RECEIVE_ID_TYPE=open_id
# 唯一允许通过飞书控制桌面 Agent 的用户 ID（open_id/user_id/union_id）。
# Larkode 不支持多用户或 *；留空时使用 FEISHU_HOOK_NOTIFICATION_USER_ID。
FEISHU_ALLOWED_USER_ID=
# 域名：FEISHU_DOMAIN 或 FEISHU_US_DOMAIN
FEISHU_MESSAGE_DOMAIN=FEISHU_DOMAIN

# 飞书是否启用
FEISHU_ENABLED=true

# ==================== AI 助手配置 ====================

# Agent 后端选择（当前支持: claude_code, codex）
AGENT_BACKEND=claude_code

# ==================== Claude Code 配置 (AGENT_BACKEND=claude_code 时必填) ====================

# Claude Code CLI 路径（必填）
CLAUDE_CODE_CLI_PATH=ccr code -c || ccr code

# ==================== Codex 配置 (AGENT_BACKEND=codex 时必填) ====================

CODEX_CLI_PATH=codex
# 默认使用 GPT-5.6 Terra / medium Think
CODEX_MODEL=gpt-5.6-terra
CODEX_REASONING_EFFORT=medium
# App Server 协议值：untrusted / on-request / never
CODEX_APPROVAL_POLICY=on-request
# App Server 协议值：read-only / workspace-write / danger-full-access
CODEX_SANDBOX=workspace-write
CODEX_REQUEST_TIMEOUT=30
CODEX_APPROVAL_TIMEOUT=300

# ==================== Tmux 会话配置 ====================

# [已废弃] tmux 会话名称（现在根据工作空间动态生成）
# TMUX_SESSION_NAME=cc
# Session 最大未更新时间（分钟）
SESSION_MAX_AGE_MINUTES=30

# ==================== Hook 配置 ====================

# AI Hook 脚本路径
AI_HOOK_SCRIPT=src/hook_handler.py
# 是否启用 Hook
HOOK_ENABLED=true

# Hook 通知配置
# Stop hook 发送通知的目标用户 ID（open_id, user_id 或 union_id）
FEISHU_HOOK_NOTIFICATION_USER_ID=
# 是否显示用户提问卡片
SHOW_USER_PROMPT_CARD=false
# 是否显示命令确认卡片
SHOW_COMMAND_CONFIRMATION_CARD=false

# ==================== 卡片消息配置 ====================

# 卡片最大长度（字符）
CARD_MAX_LENGTH=15000

# ==================== 文件消息配置 ====================

# 当内容超过 CARD_MAX_LENGTH 时，是否使用文件方式发送
USE_FILE_FOR_LONG_CONTENT=true
# 文件上传类型（stream, docx, pdf 等）
FILE_UPLOAD_TYPE=stream
# 上传文件存储目录
UPLOAD_DIR=./uploads
# 单个入站附件最大字节数（默认 50 MiB）
ATTACHMENT_MAX_BYTES=52428800

# ==================== 截屏配置 ====================

# 截屏默认行数
TMUX_CAPTURE_LINES=200

# ==================== 工作空间配置 ====================

# 工作空间自动发现
# 是否启用工作空间自动发现
WORKSPACE_DISCOVERY_ENABLED=true
# 工作空间根目录（自动发现的起始目录）（必填）
WORKSPACE_ROOT_DIR=$HOME/Workspaces
# 工作空间扫描深度（1, 2, 3...）
WORKSPACE_DISCOVERY_DEPTH=2
# 排除的目录模式（JSON 数组格式）
WORKSPACE_EXCLUDE_PATTERNS=[".git", "node_modules", "__pycache__", ".venv", "venv", ".pytest_cache", "htmlcov", ".idea", ".vscode", "dist", "build"]

# 默认工作空间目录（必须在自动发现范围内）（必填）
WORKSPACE_DEFAULT_DIR=$HOME/Workspaces/larkode

# ==================== AI 自动重启配置 ====================

# 是否启用自动重启（AI 崩溃时自动恢复）
AI_AUTO_RESTART_ENABLED=true
# 最大重启尝试次数
AI_MAX_RESTART_ATTEMPTS=3
# 重启延迟时间（秒）
AI_RESTART_DELAY=5.0
# 崩溃检测间隔（秒）
AI_CRASH_DETECTION_INTERVAL=2.0

# ==================== 依赖服务配置 ====================
# tmux/AI 启动前自动检查的依赖服务（如 ccr、lut），未启动则自动拉起。
# 该机制不依赖 AI，可保证 AI 不可用时基础服务仍能工作。

# 是否启用依赖服务自动检查
DEPENDENCY_CHECK_ENABLED=true
# 检查节流间隔（秒），避免每个命令都执行 status
DEPENDENCY_CHECK_INTERVAL=30.0
# 依赖服务启动超时（秒）
DEPENDENCY_START_TIMEOUT=15.0
# 依赖服务状态检测超时（秒）
DEPENDENCY_STATUS_TIMEOUT=5.0
# 依赖服务配置（JSON 列表），每项包含:
#   name: 服务名称
#   start_cmd: 启动命令
#   status_cmd: 状态检测命令
#   running_pattern: 状态输出中表示「运行中」的正则（不区分大小写）
#   start_pattern: 启动输出中表示「成功」的正则（可选）
DEPENDENT_SERVICES=[{"name": "ccr", "start_cmd": "ccr start", "status_cmd": "ccr status", "running_pattern": "Running", "start_pattern": "started successfully"}, {"name": "lut", "start_cmd": "lut start", "status_cmd": "lut status", "running_pattern": "Running", "start_pattern": "started successfully"}]

# ==================== 流式输出配置 ====================

# 是否启用流式输出
STREAMING_OUTPUT_ENABLED=true
# 流式输出轮询间隔（秒）
STREAMING_POLL_INTERVAL=0.5
# 流式输出更新间隔（秒）- 节流控制
STREAMING_UPDATE_INTERVAL=1.0
# 流式输出超时时间（秒）
STREAMING_TIMEOUT=3600
# 输出稳定阈值（连续多少次不变认为完成）
STREAMING_STABLE_THRESHOLD=2
# 流式输出时抓取 tmux 的行数
STREAMING_CAPTURE_LINES=10

# ==================== 任务配置 ====================

# 任务超时时间（秒）
TASK_TIMEOUT=3600
# 最大任务历史记录数
MAX_TASK_HISTORY=100

# ==================== 数据库配置 ====================

# 数据库路径
DB_PATH=./data/larkode.db

# ==================== 日志配置 ====================

# 日志目录
LOG_DIR=./logs
# 日志级别
LOG_LEVEL=INFO

# ==================== MiniMax 多媒体配置 ====================

# MiniMax API Key（从 MiniMax 开放平台获取）
MINIMAX_API_KEY=
# MiniMax Group ID
MINIMAX_GROUP_ID=
# 是否启用 MiniMax 功能
MINIMAX_ENABLED=true

# ==================== Slack 配置 (IM_PLATFORM=slack，待开发) ====================

# Slack 是否启用
SLACK_ENABLED=false
# Slack Bot Token（格式: xoxb-...）
SLACK_BOT_TOKEN=
# Slack Signing Secret
SLACK_SIGNING_SECRET=
# Slack App ID
SLACK_APP_ID=

# ==================== 钉钉配置 (IM_PLATFORM=dingtalk，待开发) ====================

# 钉钉是否启用
DINGTALK_ENABLED=false
# 钉钉 App Key
DINGTALK_APP_KEY=
# 钉钉 App Secret
DINGTALK_APP_SECRET=
